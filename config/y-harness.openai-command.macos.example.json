{
  "schema_version": 1,
  "data_directory": ".y-harness",
  "max_parallel_tool_calls": 4,
  "max_model_attempts_per_step": 16,
  "model": {
    "type": "open_ai_responses",
    "id": "openai/default",
    "model": "replace-with-an-available-model-id",
    "api_key_secret_reference": "openai/default",
    "api_key_environment": "OPENAI_API_KEY",
    "request_timeout_ms": 120000,
    "connect_timeout_ms": 10000,
    "max_response_bytes": 4194304,
    "max_concurrency": 16
  },
  "tools": [
    {
      "type": "json_command",
      "name": "uppercase",
      "description": "Convert one text value to uppercase",
      "batch_execution": "parallel_safe",
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "process": {
        "command": "/usr/bin/python3",
        "args": [
          "/absolute/path/to/Y-Harness/examples/json_tool_uppercase.py"
        ],
        "current_directory": "/absolute/path/to/Y-Harness",
        "environment_from_host": {},
        "timeout_ms": 30000,
        "max_output_bytes": 1048576,
        "launch": {
          "type": "macos_seatbelt",
          "max_concurrency": 4,
          "writable_roots": [],
          "network_access": "deny"
        }
      }
    }
  ]
}
